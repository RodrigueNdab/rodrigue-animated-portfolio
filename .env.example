# All variables are optional. Never commit real values; keep a local .env.local instead.
# None of these are exposed to the browser except NEXT_PUBLIC_SITE_URL (a public URL, not a secret).

# Canonical base URL used for metadata, sitemap and robots.txt.
# Leave unset for local development / previews: the site then sends "noindex" and
# robots.txt disallows crawling. Set it only when a real deployment URL is decided.
NEXT_PUBLIC_SITE_URL=

# Contact form (server-side only). The form is hidden on the site until
# CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL and ONE delivery option below are set.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Delivery option 1: Resend API (CONTACT_FROM_EMAIL must be a sender verified with Resend)
RESEND_API_KEY=

# Delivery option 2: SMTP (CONTACT_FROM_EMAIL must be allowed by your SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
